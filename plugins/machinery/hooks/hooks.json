{
  "hooks": {
    "SessionStart":     [{ "hooks": [
      { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/record-payload.mjs\"", "timeout": 5 },
      { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/banner.mjs\"", "timeout": 10 },
      { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/core.mjs\"", "timeout": 10 }
    ] }],
    "SubagentStart":    [{ "hooks": [
      { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/record-payload.mjs\"", "timeout": 5 },
      { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/core.mjs\"", "timeout": 10 }
    ] }],
    "UserPromptSubmit": [{ "hooks": [
      { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/record-payload.mjs\"", "timeout": 5 },
      { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/capture.mjs\"", "timeout": 30, "statusMessage": "Checking for PRULE:/URULE: mark" }
    ] }],
    "PreToolUse":       [{ "matcher": "Bash|PowerShell", "hooks": [
      { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/record-payload.mjs\"", "timeout": 5 },
      { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/quiet.mjs\"", "timeout": 15, "statusMessage": "Quiet-output check" },
      { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/no-verify.mjs\"", "timeout": 5 }
    ] }],
    "WorktreeCreate":   [{ "hooks": [
      { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/worktree-create.mjs\"", "timeout": 300, "statusMessage": "Creating worktree (unprefixed branch)" },
      { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/record-payload.mjs\"", "timeout": 5 }
    ] }]
  }
}
